pipeline {
    agent any

    environment {
        AWS_ACCOUNT_ID = "740349584703"
        AWS_REGION     = "ap-south-1"

        ECR_BACKEND  = "740349584703.dkr.ecr.ap-south-1.amazonaws.com/redbus-backend"
        ECR_FRONTEND = "740349584703.dkr.ecr.ap-south-1.amazonaws.com/redbus-frontend"

        EC2_HOST = "13.207.1.215"
    }

    stages {

        stage('Build Backend Image') {
            steps {
                sh '''
                docker build -t redbus-backend ./redbus-master/back-end-redbus
                '''
            }
        }

        stage('Build Frontend Image') {
            steps {
                sh '''
                docker build -t redbus-frontend ./redbus-master/front-end-redbus
                '''
            }
        }

     stage('Login to AWS ECR') {
    steps {
            sh '''
        aws ecr get-login-password --region ap-south-1 | \
        docker login --username AWS --password-stdin 740349584703.dkr.ecr.ap-south-1.amazonaws.com
        '''
        {
            sh '''
            aws ecr get-login-password --region ap-south-1 | \
            docker login --username AWS --password-stdin 740349584703.dkr.ecr.ap-south-1.amazonaws.com
            '''
        }
    }
}

        stage('Tag Images') {
            steps {
                sh '''
                docker tag redbus-backend:latest 740349584703.dkr.ecr.ap-south-1.amazonaws.com/redbus-backend:latest
                docker tag redbus-frontend:latest 740349584703.dkr.ecr.ap-south-1.amazonaws.com/redbus-frontend:latest
                '''
            }
        }

        stage('Push Images') {
            steps {
                sh '''
                docker push 740349584703.dkr.ecr.ap-south-1.amazonaws.com/redbus-backend:latest
                docker push 740349584703.dkr.ecr.ap-south-1.amazonaws.com/redbus-frontend:latest
                '''
            }
        }

        stage('Deploy to EC2') {
            steps {
                sh '''
                ssh -o StrictHostKeyChecking=no ubuntu@$EC2_HOST "

                aws ecr get-login-password --region ap-south-1 | \
                docker login --username AWS --password-stdin 740349584703.dkr.ecr.ap-south-1.amazonaws.com

                docker pull 740349584703.dkr.ecr.ap-south-1.amazonaws.com/redbus-backend:latest
                docker pull 740349584703.dkr.ecr.ap-south-1.amazonaws.com/redbus-frontend:latest

                docker stop backend || true
                docker rm backend || true

                docker stop frontend || true
                docker rm frontend || true

                docker run -d --name backend -p 5000:5000 740349584703.dkr.ecr.ap-south-1.amazonaws.com/redbus-backend:latest
                docker run -d --name frontend -p 3000:3000 740349584703.dkr.ecr.ap-south-1.amazonaws.com/redbus-frontend:latest

                "
                '''
            }
        }
    }
}
